<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErganiManager.UI.ViewModels"
             xmlns:views="using:ErganiManager.UI.Views"
             x:Class="ErganiManager.UI.Views.SchedulesView"
             x:DataType="vm:SchedulesViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Row 0: Header — title + two lines of buttons.
             Each line is a WrapPanel, so on a small window the buttons flow onto
             the next line instead of being cut off. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8" Spacing="6">

            <TextBlock Text="{Binding Loc[Schedules]}" FontSize="22" FontWeight="Bold" />

            <!-- Line 1: working with the schedule data -->
            <WrapPanel Orientation="Horizontal">
                <Button Content="⬆ Import"
                        Command="{Binding RequestImportCommand}"
                        Margin="0,0,6,6" IsEnabled="{Binding HasActiveCompany}" />
                <Button Content="📋 Bulk Apply"
                        Command="{Binding OpenBulkDialogCommand}"
                        Margin="0,0,6,6" IsEnabled="{Binding HasActiveCompany}" />
                <Button Content="👥 Clone to..."
                        Command="{Binding OpenCloneDialogCommand}"
                        Margin="0,0,6,6" IsEnabled="{Binding HasActiveCompany}" />
                <Button Content="{Binding Loc[ExportMonth]}"
                        Command="{Binding ExportMonthCommand}"
                        Margin="0,0,6,6" IsEnabled="{Binding HasActiveCompany}" />
                <Button Content="🏖 Holidays"
                        Command="{Binding OpenHolidaysCommand}"
                        Margin="0,0,6,6" IsEnabled="{Binding HasActiveCompany}" />
                <Button Content="📜 Log"
                        Command="{Binding OpenLogCommand}"
                        Margin="0,0,6,6" IsEnabled="{Binding HasActiveCompany}" />
            </WrapPanel>

            <!-- Line 2: sending to Ergani -->
            <WrapPanel Orientation="Horizontal">
                <Button Content="{Binding SubmitScheduleButtonText}"
                        Command="{Binding SubmitScheduleToErganiCommand}"
                        Margin="0,0,6,6" IsEnabled="{Binding HasActiveCompany}" />
                <Button Content="{Binding SubmitOvertimeButtonText}"
                        Command="{Binding SubmitOvertimesCommand}"
                        Margin="0,0,6,6" IsEnabled="{Binding HasActiveCompany}" />
                <Button Content="{Binding SubmitHolidaysButtonText}"
                        Command="{Binding SubmitHolidaysCommand}"
                        Margin="0,0,6,6" IsEnabled="{Binding HasActiveCompany}" />
                <Button Content="🌐 Open Schedule Ergani portal"
                        Command="{Binding OpenErganiPortalCommand}"
                        Margin="0,0,6,6" IsEnabled="{Binding HasActiveCompany}" />
            </WrapPanel>
        </StackPanel>

        <!-- Row 1: Controls bar -->
        <Border Grid.Row="1" Background="#1A1D23" CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                <!-- Employee picker -->
                <TextBlock Grid.Column="0" Text="Employee:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableEmployees}"
                          SelectedItem="{Binding SelectedEmployee}" Width="200">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding FullName}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- View mode -->
                <Button Grid.Column="2" Content="Month"
                        Command="{Binding SetViewModeCommand}" CommandParameter="Month"
                        Margin="12,0,4,0"
                        Classes.accent="{Binding IsMonthView}" />
                <Button Grid.Column="3" Content="Week"
                        Command="{Binding SetViewModeCommand}" CommandParameter="Week"
                        Margin="0,0,12,0"
                        Classes.accent="{Binding IsWeekView}" />

                <!-- Month navigation -->
                <Panel Grid.Column="4" IsVisible="{Binding IsMonthView}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="◀" Command="{Binding PreviousMonthCommand}" />
                        <TextBlock Text="{Binding MonthLabel}" FontWeight="SemiBold" Width="130"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Content="▶" Command="{Binding NextMonthCommand}" />
                    </StackPanel>
                </Panel>

                <!-- Week navigation -->
                <Panel Grid.Column="4" IsVisible="{Binding IsWeekView}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="◀" Command="{Binding PreviousWeekCommand}" />
                        <TextBlock Text="{Binding WeekLabel}" FontWeight="SemiBold" Width="160"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Content="▶" Command="{Binding NextWeekCommand}" />
                    </StackPanel>
                </Panel>

                <!-- Selection info -->
                <Border Grid.Column="5" IsVisible="{Binding HasSelection}"
                        Background="#2D4A2D" CornerRadius="6" Padding="8,4" Margin="12,0,4,0">
                    <TextBlock Text="{Binding SelectionLabel}" Foreground="#81C784" FontSize="12" />
                </Border>
                <Button Grid.Column="6" Content="✕ Clear" IsVisible="{Binding HasSelection}"
                        Command="{Binding ClearSelectionCommand}" Margin="0,0,4,0" />
                <Button Grid.Column="7" Content="{Binding DeleteSelectedButtonText}"
                        IsVisible="{Binding HasSelection}"
                        Command="{Binding DeleteSelectedCommand}"
                        Foreground="#EF9A9A" Margin="0,0,4,0" />

            </Grid>
        </Border>

        <!-- Row 2: Status -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="Gray" FontSize="12"
                   Margin="0,0,0,8"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Row 3: Calendar -->
        <ScrollViewer Grid.Row="3">
            <!-- Calendar -->
<StackPanel>

    <TextBlock Text="Click a day to open it · Ctrl+Click to select days, then Submit / Bulk Apply / Delete act on just those days"
               FontSize="11"
               Foreground="#666"
               Margin="0,0,0,8" />

    <!-- Header + dates use exactly the same 7-column grid -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
          ColumnDefinitions="*,*,*,*,*,*,*"
          ColumnSpacing="4"
          RowSpacing="4">

        <!-- Day headers -->
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Mon"
                   HorizontalAlignment="Center"
                   Foreground="#888"
                   FontSize="12"/>

        <TextBlock Grid.Row="0" Grid.Column="1"
                   Text="Tue"
                   HorizontalAlignment="Center"
                   Foreground="#888"
                   FontSize="12"/>

        <TextBlock Grid.Row="0" Grid.Column="2"
                   Text="Wed"
                   HorizontalAlignment="Center"
                   Foreground="#888"
                   FontSize="12"/>

        <TextBlock Grid.Row="0" Grid.Column="3"
                   Text="Thu"
                   HorizontalAlignment="Center"
                   Foreground="#888"
                   FontSize="12"/>

        <TextBlock Grid.Row="0" Grid.Column="4"
                   Text="Fri"
                   HorizontalAlignment="Center"
                   Foreground="#888"
                   FontSize="12"/>

        <TextBlock Grid.Row="0" Grid.Column="5"
                   Text="Sat"
                   HorizontalAlignment="Center"
                   Foreground="#777"
                   FontSize="12"/>

        <TextBlock Grid.Row="0" Grid.Column="6"
                   Text="Sun"
                   HorizontalAlignment="Center"
                   Foreground="#777"
                   FontSize="12"/>


        <!-- Calendar cells -->
        <ItemsControl Grid.Row="1"
                      Grid.RowSpan="6"
                      Grid.Column="0"
                      Grid.ColumnSpan="7"
                      ItemsSource="{Binding Cells}">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CalendarCellViewModel">

                    <Panel Margin="2"
                           MinHeight="110">

                        <!-- Empty filler -->
                        <Border IsVisible="{Binding !IsInMonth}" />

                        <!-- Day cell -->
                        <Border IsVisible="{Binding IsInMonth}"
                                Tag="{Binding}"
                                PointerPressed="OnCellPressed"
                                CornerRadius="8"
                                Cursor="Hand"
                                Padding="8,6"
                                BorderThickness="2">

                            <Border.Background>
                                <SolidColorBrush Color="#1A1D23" />
                            </Border.Background>

                            <Border.Styles>
                                <Style Selector="Border:pointerover">
                                    <Setter Property="Background"
                                            Value="#22252C" />
                                </Style>
                            </Border.Styles>

                            <Border.BorderBrush>
                                <SolidColorBrush Color="#3A3F4B" />
                            </Border.BorderBrush>

                            <StackPanel ToolTip.Tip="{Binding HolidayTooltip}">

                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DayNumberText}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding IsToday,
                                                   Converter={x:Static vm:BoolToBackgroundConverter.Instance}}" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding WorkTypeIcon}"
                                               FontSize="13" />

                                </Grid>

                                <TextBlock Text="{Binding TimeRangeText}"
                                           FontSize="10"
                                           Foreground="#AAAAAA"
                                           TextWrapping="Wrap" />

                                <Border IsVisible="{Binding HasOfficialHoliday}"
                                        Background="#3A2F1B"
                                        CornerRadius="3"
                                        Padding="4,1"
                                        Margin="0,2,0,0">

                                    <TextBlock Text="{Binding OfficialHolidayText}"
                                               FontSize="9"
                                               Foreground="#FFD180"
                                               TextTrimming="CharacterEllipsis" />

                                </Border>

                                <Border IsVisible="{Binding HasUserHoliday}"
                                        Background="#1E3545"
                                        CornerRadius="3"
                                        Padding="4,1"
                                        Margin="0,2,0,0">

                                    <TextBlock Text="{Binding UserHolidayText}"
                                               FontSize="9"
                                               Foreground="#90CAF9"
                                               TextTrimming="CharacterEllipsis" />

                                </Border>

                                <TextBlock Text="📤 sent"
                                           FontSize="9"
                                           Foreground="#81C784"
                                           IsVisible="{Binding IsSubmitted}" />

                                <Border IsVisible="{Binding IsSelected}"
                                        Background="#1B5E20"
                                        CornerRadius="3"
                                        Padding="4,1"
                                        Margin="0,2,0,0">

                                    <TextBlock Text="✓ Selected"
                                               FontSize="9"
                                               Foreground="#81C784" />

                                </Border>

                            </StackPanel>

                        </Border>

                    </Panel>

                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>

    </Grid>

</StackPanel>
        </ScrollViewer>

        <!-- ── Day dialog overlay ── -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                IsVisible="{Binding IsDayDialogOpen}"
                Background="#BB000000" ZIndex="50">
            <Border Background="#1E2128" CornerRadius="12" Padding="24"
                    Width="500" MaxHeight="520"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid RowDefinitions="*,Auto">
                    <ScrollViewer Grid.Row="0">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding EditingDate, StringFormat='Schedule for {0:dd/MM/yyyy}'}"
                                       FontSize="16" FontWeight="Bold" />

                            <TextBlock Text="{Binding Loc[WorkType]}" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding AvailableWorkTypes}"
                                      SelectedItem="{Binding EditingWorkType}"
                                      HorizontalAlignment="Stretch" />

                            <StackPanel IsVisible="{Binding ShowTimeFields}" Spacing="10">
                                <TextBlock Text="{Binding Loc[Branch]}" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding AvailableBranches}"
                                          SelectedItem="{Binding EditingBranch}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <!-- Stacked vertically: TimePicker has a wide minimum width and overlapped when side by side -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Loc[StartTime]}" FontWeight="SemiBold" />
                                    <TimePicker SelectedTime="{Binding EditingStartTime}" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch" />
                                    <TextBlock Text="{Binding Loc[EndTime]}" FontWeight="SemiBold" />
                                    <TimePicker SelectedTime="{Binding EditingEndTime}" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding EditingOvertimeNote}" Foreground="#FFB74D"
                                       FontSize="12" TextWrapping="Wrap"
                                       IsVisible="{Binding EditingOvertimeNote,
                                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <TextBlock Text="{Binding Loc[Comments]}" FontWeight="SemiBold" />
                            <TextBox Text="{Binding EditingComments}" />

                            <TextBlock Text="{Binding EditingActualText}" Foreground="Gray" FontSize="11"
                                       IsVisible="{Binding EditingActualText,
                                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding EditingSubmissionText}" FontSize="11"
                                       Foreground="#81C784"
                                       IsVisible="{Binding EditingSubmissionText,
                                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                Spacing="8" Margin="0,12,0,0">
                        <Button Content="{Binding Loc[Cancel]}"
                                Command="{Binding CloseDayDialogCommand}" />
                        <Button Content="🗑 Delete"
                                Command="{Binding DeleteDayCommand}"
                                IsVisible="{Binding IsEditingExisting}"
                                Foreground="#EF9A9A" />
                        <Button Content="📤 Save &amp; Submit"
                                Command="{Binding SaveAndSubmitDayCommand}"
                                IsVisible="{Binding CanSubmitEditingDay}" />
                        <Button Content="{Binding Loc[Save]}"
                                Command="{Binding SaveDayCommand}" Classes="accent" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- ── Bulk apply dialog overlay ── -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                IsVisible="{Binding IsBulkDialogOpen}"
                Background="#BB000000" ZIndex="50">
            <Border Background="#1E2128" CornerRadius="12" Padding="24"
                    Width="420" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid RowDefinitions="*,Auto">
                    <StackPanel Grid.Row="0" Spacing="10">
                        <TextBlock Text="📋 Bulk Apply Schedule" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="{Binding SelectionLabel}" FontSize="12" Foreground="Gray" />

                        <TextBlock Text="{Binding Loc[WorkType]}" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding AvailableWorkTypes}"
                                  SelectedItem="{Binding BulkWorkType}"
                                  HorizontalAlignment="Stretch" />

                        <StackPanel IsVisible="{Binding BulkShowTimeFields}" Spacing="10">
                            <TextBlock Text="{Binding Loc[Branch]}" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding AvailableBranches}"
                                      SelectedItem="{Binding EditingBranch}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <!-- Stacked vertically: TimePicker has a wide minimum width and overlapped when side by side -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Loc[StartTime]}" FontWeight="SemiBold" />
                                <TimePicker SelectedTime="{Binding BulkStartTime}" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch" />
                                <TextBlock Text="{Binding Loc[EndTime]}" FontWeight="SemiBold" />
                                <TimePicker SelectedTime="{Binding BulkEndTime}" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Day of week checkboxes — only shown when no specific days selected -->
                        <StackPanel IsVisible="{Binding !HasSelection}" Spacing="6">
                            <TextBlock Text="Apply to days:" FontWeight="SemiBold" />
                            <WrapPanel Orientation="Horizontal">
                                <CheckBox Content="Mon" IsChecked="{Binding BulkMonday}" Margin="0,0,12,4" />
                                <CheckBox Content="Tue" IsChecked="{Binding BulkTuesday}" Margin="0,0,12,4" />
                                <CheckBox Content="Wed" IsChecked="{Binding BulkWednesday}" Margin="0,0,12,4" />
                                <CheckBox Content="Thu" IsChecked="{Binding BulkThursday}" Margin="0,0,12,4" />
                                <CheckBox Content="Fri" IsChecked="{Binding BulkFriday}" Margin="0,0,12,4" />
                                <CheckBox Content="Sat" IsChecked="{Binding BulkSaturday}" Margin="0,0,12,4" />
                                <CheckBox Content="Sun" IsChecked="{Binding BulkSunday}" Margin="0,0,12,4" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,12,0,0" ColumnSpacing="8">
                        <Button Grid.Column="0" Content="{Binding Loc[Cancel]}"
                                Command="{Binding CloseBulkDialogCommand}"
                                HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="Apply"
                                Command="{Binding ApplyBulkCommand}" Classes="accent"
                                HorizontalAlignment="Stretch" />
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ── Clone dialog overlay ── -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                IsVisible="{Binding IsCloneDialogOpen}"
                Background="#BB000000" ZIndex="50">
            <Border Background="#1E2128" CornerRadius="12" Padding="24"
                    Width="440" Height="500"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                    <TextBlock Grid.Row="0" Text="👥 Clone Schedule to Employees"
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="1" FontSize="12" Foreground="Gray" Margin="0,0,0,8">
                        <Run Text="Copying " />
                        <Run Text="{Binding SelectedEmployee.FullName}" FontWeight="SemiBold" />
                        <Run Text="'s schedule for " />
                        <Run Text="{Binding CloneFrom, StringFormat='{}{0:dd/MM}'}" />
                        <Run Text=" – " />
                        <Run Text="{Binding CloneTo, StringFormat='{}{0:dd/MM/yyyy}'}" />
                    </TextBlock>
                    <TextBlock Grid.Row="2" Text="Select employees to copy to:"
                               FontWeight="SemiBold" Margin="0,0,0,8" />

                    <ScrollViewer Grid.Row="3">
                        <ItemsControl ItemsSource="{Binding CloneTargets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CloneTargetEmployee">
                                    <Border Background="#22252C" CornerRadius="6" Padding="12,8">
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  Content="{Binding Name}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="4" ColumnDefinitions="*,*" Margin="0,12,0,0" ColumnSpacing="8">
                        <Button Grid.Column="0" Content="{Binding Loc[Cancel]}"
                                Command="{Binding CloseCloneDialogCommand}"
                                HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="Copy Schedule"
                                Command="{Binding ApplyCloneCommand}" Classes="accent"
                                HorizontalAlignment="Stretch" />
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ── Holidays form ── -->
        <Panel Grid.Row="0" Grid.RowSpan="4" ZIndex="45" IsVisible="{Binding Holidays.IsOpen}">
            <views:HolidayDialogView DataContext="{Binding Holidays}" />
        </Panel>

        <!-- ── Submission log dialog (Ergani responses + PDF) ── -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                IsVisible="{Binding IsLogOpen}"
                Background="#BB000000" ZIndex="50">
            <Border Background="#1E2128" CornerRadius="12" Padding="20"
                    Width="900" Height="560"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10">
                    <TextBlock Grid.Row="0" Text="{Binding LogTitle}" FontSize="17" FontWeight="Bold" />

                    <Panel Grid.Row="1">
                        <TextBlock Text="No schedule has been submitted to Ergani for this employee yet."
                                   Foreground="Gray" IsVisible="{Binding !HasLogRows}" />
                        <ScrollViewer IsVisible="{Binding HasLogRows}">
                            <ItemsControl ItemsSource="{Binding LogRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScheduleLogRow">
                                        <Border Background="#22252C" CornerRadius="6"
                                                Padding="10,8" Margin="0,0,0,4">
                                            <Grid ColumnDefinitions="Auto,100,150,*,Auto,Auto" ColumnSpacing="10">
                                                <TextBlock Grid.Column="0" Text="{Binding StatusIcon}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding ScheduleDateText}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding SubmittedAtText}"
                                                           Foreground="#AAAAAA" FontSize="12"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Summary}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                                <Button Grid.Column="4" Content="Response"
                                                        Tag="{Binding}" Click="OnLogResponseClick" />
                                                <Button Grid.Column="5" Content="PDF"
                                                        Tag="{Binding}" Click="OnLogPdfClick"
                                                        IsEnabled="{Binding HasProtocol}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Panel>

                    <TextBlock Grid.Row="2" Text="{Binding LogStatus}" Foreground="Gray" FontSize="12"
                               IsVisible="{Binding LogStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Button Grid.Row="3" Content="Close" Command="{Binding CloseLogCommand}"
                            HorizontalAlignment="Right" Width="100" />
                </Grid>
            </Border>
        </Border>

        <!-- ── Raw Ergani response ── -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                IsVisible="{Binding IsResponseOpen}"
                Background="#AA000000" ZIndex="60">
            <Border Background="#1E2128" CornerRadius="12" Padding="20"
                    Width="800" Height="560"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                    <TextBlock Grid.Row="0" Text="{Binding ResponseTitle}" FontSize="17" FontWeight="Bold" />
                    <TextBox Grid.Row="1" Text="{Binding ResponseText}" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                             ScrollViewer.VerticalScrollBarVisibility="{x:Static ScrollBarVisibility.Auto}"
                             ScrollViewer.HorizontalScrollBarVisibility="{x:Static ScrollBarVisibility.Auto}" />
                    <Button Grid.Row="2" Content="Close" Command="{Binding CloseResponseCommand}"
                            HorizontalAlignment="Right" Width="100" />
                </Grid>
            </Border>
        </Border>

        <!-- ── Delete confirmation ── -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                IsVisible="{Binding IsConfirmDeleteOpen}"
                Background="#BB000000" ZIndex="70">
            <Border Background="#1E2128" CornerRadius="12" Padding="24"
                    Width="440" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="🗑 Delete schedule" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="{Binding ConfirmDeleteMessage}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="{Binding Loc[Cancel]}" Command="{Binding CancelDeleteCommand}" />
                        <Button Content="Delete" Command="{Binding ConfirmDeleteCommand}"
                                Foreground="#EF9A9A" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>

</UserControl>
