<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErganiManager.UI.ViewModels"
             x:Class="ErganiManager.UI.Views.AdministrationView"
             x:DataType="vm:AdministrationViewModel">

    <Grid>
        <ScrollViewer>
            <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Loc[AdminTitle]}" FontSize="22" FontWeight="Bold" />

                <Border Background="#1A1D23" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding Loc[AdminDatabase]}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DatabaseInfo}" Foreground="Gray" TextWrapping="Wrap" />
                        <Button Content="{Binding Loc[AdminBackup]}" Click="OnBackupClick"
                                IsEnabled="{Binding !IsBusy}" />
                    </StackPanel>
                </Border>

                <Border Background="#1A1D23" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding Loc[AdminLocalCache]}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CacheInfo}" Foreground="Gray" TextWrapping="Wrap" />
                        <Button Content="{Binding Loc[AdminDeleteCache]}"
                                Command="{Binding AskDeleteCacheCommand}"
                                IsEnabled="{Binding !IsBusy}" />
                    </StackPanel>
                </Border>

                <Border Background="#1A1D23" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="⏱ Working time rounding" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12"
                                   Text="Used by the 'Rounded' column of the Declared vs actual report. The worked time is taken from the exact clock-in, then its minutes are matched to a range and rounded to the whole hour plus the 'Round to' minutes (60 = next hour). Minutes not covered by any range stay as they are." />

                        <Grid ColumnDefinitions="110,110,130,*" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="From minute" Foreground="Gray" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="To minute" Foreground="Gray" FontSize="11" />
                            <TextBlock Grid.Column="2" Text="Round to (min)" Foreground="Gray" FontSize="11" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding RoundingBands}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RoundingBandEdit">
                                    <Grid ColumnDefinitions="110,110,130,*" ColumnSpacing="8">
                                        <NumericUpDown Grid.Column="0" Value="{Binding From}" Minimum="0" Maximum="59" Increment="1" FormatString="0" />
                                        <NumericUpDown Grid.Column="1" Value="{Binding To}" Minimum="0" Maximum="59" Increment="1" FormatString="0" />
                                        <NumericUpDown Grid.Column="2" Value="{Binding RoundTo}" Minimum="0" Maximum="60" Increment="15" FormatString="0" />
                                        <Button Grid.Column="3" Content="✕" HorizontalAlignment="Left"
                                                Command="{Binding $parent[ItemsControl].((vm:AdministrationViewModel)DataContext).RemoveRoundingBandCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="＋ Add range" Command="{Binding AddRoundingBandCommand}" />
                            <Button Content="↺ Restore defaults" Command="{Binding RestoreRoundingDefaultsCommand}" />
                            <Button Content="💾 Save" Command="{Binding SaveRoundingCommand}" Classes="accent" />
                        </StackPanel>
                        <TextBlock Text="{Binding RoundingStatus}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Background="#1A1D23" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="🌐 Schedule Portal" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12"
                                   Text="These settings are used ONLY by the Open Ergani portal button in the Schedules form. The login username/password still come from the selected company." />
                        <TextBlock Text="Schedule portal base address" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SchedulePortalBaseUrl}" Watermark="https://trialv2eservices.yeka.gr/" />
                        <TextBlock Text="Schedule page after login" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SchedulePortalTargetUrl}" Watermark="Target page URL or path" />
                        <TextBlock Text="Schedule FROM date field ID" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SchedulePortalFromField}" />
                        <TextBlock Text="Schedule TO date field ID" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SchedulePortalToField}" />
                        <TextBlock Text="Schedule date format" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SchedulePortalDateFormat}" Watermark="dd/MM/yyyy" Width="160" HorizontalAlignment="Left" />
                        <CheckBox IsChecked="{Binding SchedulePortalAutoSearch}" Content="Automatically press Search after the schedule dates are filled" />
                        <CheckBox IsChecked="{Binding SchedulePortalAutoDownload}" Content="After Search, automatically download the Excel export" />
                        <TextBlock Text="Schedule Search button ID" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SchedulePortalSearchButton}" />
                        <TextBlock Text="Schedule Excel download folder" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SchedulePortalDownloadFolder}" Watermark="Empty = Documents\ErganiManager\Downloads" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                            <Button Content="💾 Save Schedule Portal settings" Command="{Binding SaveSchedulePortalCommand}" Classes="accent" />
                            <TextBlock Text="{Binding SchedulePortalStatus}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#1A1D23" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="🌐 Work Cards Portal" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12"
                                   Text="These settings are used ONLY by the Open Work Cards portal button. Today's date is entered in both date fields and the Search button is pressed." />
                        <TextBlock Text="Work Cards portal base address" FontWeight="SemiBold" />
                        <TextBox Text="{Binding WorkCardsPortalBaseUrl}" Watermark="https://trialv2eservices.yeka.gr/" />
                        <TextBlock Text="Work Cards page after login" FontWeight="SemiBold" />
                        <TextBox Text="{Binding WorkCardsPortalTargetUrl}" Watermark="https://trialv2eservices.yeka.gr/WTO/Workcard/DailyWorkTimesSearch.aspx" />
                        <TextBlock Text="Work Cards FROM date field ID" FontWeight="SemiBold" />
                        <TextBox Text="{Binding WorkCardsPortalFromField}" />
                        <TextBlock Text="Work Cards TO date field ID" FontWeight="SemiBold" />
                        <TextBox Text="{Binding WorkCardsPortalToField}" />
                        <TextBlock Text="Work Cards date format" FontWeight="SemiBold" />
                        <TextBox Text="{Binding WorkCardsPortalDateFormat}" Watermark="dd/MM/yyyy" Width="160" HorizontalAlignment="Left" />
                        <CheckBox IsChecked="{Binding WorkCardsPortalAutoSearch}" Content="Automatically press Search after today's date is filled" />
                        <TextBlock Text="Work Cards Search button ID" FontWeight="SemiBold" />
                        <TextBox Text="{Binding WorkCardsPortalSearchButton}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                            <Button Content="💾 Save Work Cards Portal settings" Command="{Binding SaveWorkCardsPortalCommand}" Classes="accent" />
                            <TextBlock Text="{Binding WorkCardsPortalStatus}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#2A1A1A" BorderBrush="#EF5350" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding Loc[AdminDangerZone]}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#EF9A9A" />
                        <Button Content="{Binding Loc[AdminDeleteDb]}"
                                Command="{Binding AskDeleteDatabaseCommand}"
                                IsEnabled="{Binding !IsBusy}" Foreground="#EF9A9A" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- Confirmation overlay -->
        <Border IsVisible="{Binding IsConfirmOpen}" Background="#CC000000" ZIndex="50">
            <Border Background="#1E2128" CornerRadius="10" Padding="24" Width="460"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Content="{Binding Loc[Cancel]}"
                                Command="{Binding CancelConfirmCommand}" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="{Binding Loc[AdminConfirm]}"
                                Command="{Binding ConfirmCommand}" Classes="accent"
                                HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
